{
  "openapi": "3.1.0",
  "info": {
    "title": "EconoCausal API",
    "description": "Prescriptive AI Dynamic Pricing & Discount Allocation Engine",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/mock-customers": {
      "get": {
        "tags": [
          "Scoring & Previews"
        ],
        "summary": "Generate synthetic customer ITE dataset for UI testing",
        "description": "Return synthetic customer records with Causal ITE scores for frontend integration.",
        "operationId": "get_mock_customers_api_v1_mock_customers_get",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Number of customers to generate",
              "default": 50,
              "title": "Count"
            },
            "description": "Number of customers to generate"
          },
          {
            "name": "treatment_cost",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Discount cost per customer",
              "default": 10.0,
              "title": "Treatment Cost"
            },
            "description": "Discount cost per customer"
          },
          {
            "name": "customer_value",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "description": "Expected order value",
              "default": 50.0,
              "title": "Customer Value"
            },
            "description": "Expected order value"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CustomerDataPoint"
                  },
                  "title": "Response Get Mock Customers Api V1 Mock Customers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/score-summary": {
      "post": {
        "tags": [
          "Scoring & Previews"
        ],
        "summary": "Calculate aggregate uplift statistics across a customer cohort",
        "description": "Compute distributional metrics on incoming customer ITE scores before optimization.",
        "operationId": "summarize_customer_scores_api_v1_score_summary_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/CustomerDataPoint"
                },
                "type": "array",
                "title": "Customers"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Summarize Customer Scores Api V1 Score Summary Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/allocate": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Compute optimal discount allocation under budget constraints",
        "description": "Execute SciPy-constrained linear programming optimization for customer discount allocation.",
        "operationId": "allocate_budget_api_v1_allocate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest-and-allocate": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Ingest raw causal ML records from M2 and compute optimal discount allocation",
        "description": "Bridge endpoint converting raw EconML/DoWhy records directly into optimal discount allocations.",
        "operationId": "ingest_and_allocate_api_v1_ingest_and_allocate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestAndAllocateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/allocate-multi-tier": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Compute optimal multi-tier discount allocation under budget constraints",
        "description": "Execute SciPy-constrained linear programming optimization for multi-tier discount allocation.",
        "operationId": "allocate_multi_tier_budget_api_v1_allocate_multi_tier_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MultiTierOptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compare-policies": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Benchmark causal optimization against naive blanket discount baseline",
        "description": "Benchmark causal optimization against standard blanket discount allocation.",
        "operationId": "compare_policies_api_v1_compare_policies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyComparisonResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drift-check": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Evaluate distribution drift between reference and current ITE distributions",
        "description": "Evaluate covariate and treatment effect distribution drift using PSI and KS-2sample test.",
        "operationId": "check_drift_api_v1_drift_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriftCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriftCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uplift-curve": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Generate cumulative uplift curve and Qini metrics for campaign evaluation",
        "description": "Compute cumulative uplift deciles, AUUC score, and Qini coefficient across customer cohort.",
        "operationId": "get_uplift_curve_api_v1_uplift_curve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpliftCurveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpliftCurveResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/executive-report": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Generate executive summary report with causal quadrant segmentation",
        "description": "Generate executive campaign report comparing causal optimization to blanket discounting.",
        "operationId": "get_executive_report_api_v1_executive_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutiveReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulate-confidence": {
      "post": {
        "tags": [
          "Optimization & Allocation"
        ],
        "summary": "Run Monte Carlo simulation to quantify policy risk and confidence bounds",
        "description": "Evaluate optimal policy robustness against ITE score uncertainty via Monte Carlo sampling.",
        "operationId": "simulate_confidence_api_v1_simulate_confidence_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MonteCarloSimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonteCarloSimulationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root  Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Readiness Check",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Check Ready Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerAllocation": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "assigned_discount": {
            "type": "number",
            "title": "Assigned Discount",
            "description": "Discount allocated ($0, $10, $20, etc.)"
          },
          "is_targeted": {
            "type": "boolean",
            "title": "Is Targeted",
            "description": "Whether customer received a promotional offer"
          },
          "expected_incremental_revenue": {
            "type": "number",
            "title": "Expected Incremental Revenue"
          },
          "expected_net_profit": {
            "type": "number",
            "title": "Expected Net Profit"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "assigned_discount",
          "is_targeted",
          "expected_incremental_revenue",
          "expected_net_profit"
        ],
        "title": "CustomerAllocation",
        "description": "Recommended discount decision for an individual customer."
      },
      "CustomerDataPoint": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "Unique customer identifier"
          },
          "baseline_conversion_prob": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Baseline Conversion Prob",
            "description": "Predicted baseline conversion without discount"
          },
          "predicted_ite": {
            "type": "number",
            "title": "Predicted Ite",
            "description": "Estimated Individual Treatment Effect (uplift delta)"
          },
          "treatment_cost": {
            "type": "number",
            "minimum": 0.0,
            "title": "Treatment Cost",
            "description": "Promotional cost of the discount tier (e.g., $10 or $20)"
          },
          "customer_value": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Customer Value",
            "description": "Expected average order value or customer lifetime value",
            "default": 50.0
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "baseline_conversion_prob",
          "predicted_ite",
          "treatment_cost"
        ],
        "title": "CustomerDataPoint",
        "description": "Customer-level treatment effect score produced by M2 (Causal ML)."
      },
      "DriftCheckRequest": {
        "properties": {
          "reference_ites": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 5,
            "title": "Reference Ites",
            "description": "Historical reference treatment effect distribution"
          },
          "current_ites": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 5,
            "title": "Current Ites",
            "description": "Current scoring batch treatment effect distribution"
          },
          "psi_threshold": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Psi Threshold",
            "description": "PSI threshold for critical distribution drift",
            "default": 0.25
          },
          "ks_alpha": {
            "type": "number",
            "exclusiveMaximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Ks Alpha",
            "description": "Significance level alpha for Kolmogorov-Smirnov test",
            "default": 0.05
          }
        },
        "type": "object",
        "required": [
          "reference_ites",
          "current_ites"
        ],
        "title": "DriftCheckRequest",
        "description": "Payload to evaluate distribution drift between reference and current ITE scores."
      },
      "DriftCheckResponse": {
        "properties": {
          "drift_detected": {
            "type": "boolean",
            "title": "Drift Detected"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "psi_score": {
            "type": "number",
            "title": "Psi Score"
          },
          "ks_statistic": {
            "type": "number",
            "title": "Ks Statistic"
          },
          "ks_pvalue": {
            "type": "number",
            "title": "Ks Pvalue"
          },
          "recommendation": {
            "type": "string",
            "title": "Recommendation"
          },
          "reference_count": {
            "type": "integer",
            "title": "Reference Count"
          },
          "current_count": {
            "type": "integer",
            "title": "Current Count"
          }
        },
        "type": "object",
        "required": [
          "drift_detected",
          "severity",
          "psi_score",
          "ks_statistic",
          "ks_pvalue",
          "recommendation",
          "reference_count",
          "current_count"
        ],
        "title": "DriftCheckResponse",
        "description": "Statistical distribution drift evaluation report."
      },
      "ExecutiveReportResponse": {
        "properties": {
          "total_customers": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Customers",
            "description": "Total customers evaluated in campaign cohort"
          },
          "budget": {
            "type": "number",
            "minimum": 0.0,
            "title": "Budget",
            "description": "Total campaign budget"
          },
          "total_spend": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Spend",
            "description": "Total budget spent under causal optimization"
          },
          "expected_incremental_revenue": {
            "type": "number",
            "title": "Expected Incremental Revenue",
            "description": "Total expected incremental revenue generated"
          },
          "expected_net_profit": {
            "type": "number",
            "title": "Expected Net Profit",
            "description": "Total expected net profit (revenue - spend)"
          },
          "roi_pct": {
            "type": "number",
            "title": "Roi Pct",
            "description": "Net campaign Return on Investment percentage"
          },
          "savings_vs_blanket": {
            "type": "number",
            "title": "Savings Vs Blanket",
            "description": "Net profit improvement of causal SciPy over blanket baseline"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentSummarySchema"
            },
            "type": "array",
            "title": "Segments",
            "description": "Quadrant breakdown of customer cohort"
          },
          "headline_summary": {
            "type": "string",
            "title": "Headline Summary",
            "description": "Natural language executive summary headline"
          },
          "bullet_insights": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Bullet Insights",
            "description": "Key actionable business insights"
          }
        },
        "type": "object",
        "required": [
          "total_customers",
          "budget",
          "total_spend",
          "expected_incremental_revenue",
          "expected_net_profit",
          "roi_pct",
          "savings_vs_blanket",
          "segments",
          "headline_summary",
          "bullet_insights"
        ],
        "title": "ExecutiveReportResponse",
        "description": "High-level executive summary report comparing causal optimization to blanket discounting."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestAndAllocateRequest": {
        "properties": {
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "minItems": 1,
            "title": "Records",
            "description": "Raw customer/treatment records from causal ML pipeline"
          },
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "description": "Total available campaign budget"
          },
          "default_cost": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Default Cost",
            "description": "Default promotional cost if missing from records",
            "default": 10.0
          },
          "default_value": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Default Value",
            "description": "Default customer economic value if missing",
            "default": 50.0
          },
          "objective": {
            "$ref": "#/components/schemas/OptimizationObjective",
            "description": "Target business objective",
            "default": "maximize_profit"
          }
        },
        "type": "object",
        "required": [
          "records",
          "budget"
        ],
        "title": "IngestAndAllocateRequest",
        "description": "Payload to ingest raw M2 causal inference records and perform budget allocation."
      },
      "MonteCarloSimulationRequest": {
        "properties": {
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "description": "Total available campaign budget"
          },
          "objective": {
            "$ref": "#/components/schemas/OptimizationObjective",
            "description": "Target business objective",
            "default": "maximize_profit"
          },
          "min_spend_per_user": {
            "type": "number",
            "minimum": 0.0,
            "title": "Min Spend Per User",
            "description": "Minimum subsidy per targeted user",
            "default": 0.0
          },
          "customers": {
            "items": {
              "$ref": "#/components/schemas/CustomerDataPoint"
            },
            "type": "array",
            "minItems": 1,
            "title": "Customers",
            "description": "List of customers with ITE scores"
          },
          "ite_std_error": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Ite Std Error",
            "description": "Standard deviation of ITE perturbation noise",
            "default": 0.03
          },
          "num_simulations": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 10.0,
            "title": "Num Simulations",
            "description": "Number of Monte Carlo simulation trials",
            "default": 200
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed",
            "description": "Random seed for reproducible sampling",
            "default": 42
          }
        },
        "type": "object",
        "required": [
          "budget",
          "customers"
        ],
        "title": "MonteCarloSimulationRequest",
        "description": "Payload to simulate policy confidence and risk distributions via Monte Carlo sampling."
      },
      "MonteCarloSimulationResponse": {
        "properties": {
          "num_simulations": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Num Simulations",
            "description": "Number of simulation trials executed"
          },
          "budget": {
            "type": "number",
            "minimum": 0.0,
            "title": "Budget",
            "description": "Total campaign budget"
          },
          "total_spend": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Spend",
            "description": "Total promotional spend under optimal policy"
          },
          "mean_net_profit": {
            "type": "number",
            "title": "Mean Net Profit",
            "description": "Expected mean net profit across trials"
          },
          "std_net_profit": {
            "type": "number",
            "minimum": 0.0,
            "title": "Std Net Profit",
            "description": "Standard deviation of realized net profits"
          },
